# QueueForge configuration. Copy to .env and adjust. Placeholders only: never commit real secrets.
# Every backend setting is QF_<NAME>; see backend/queueforge/config.py for the full list.

# development | test | production. Production refuses default secrets and wildcard CORS.
QF_ENV=development

# Required. Signs API key hashes; changing it invalidates every existing API key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
QF_SECRET_KEY=replace-with-a-long-random-value-at-least-32-chars

# PostgreSQL (asyncpg driver) and Redis. Docker Compose builds these from POSTGRES_PASSWORD.
QF_DATABASE_URL=postgresql+asyncpg://queueforge:queueforge@localhost:5432/queueforge
QF_REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=queueforge

# Browser origins allowed to call the API with credentials (comma-separated).
QF_CORS_ORIGINS=http://localhost:3000
# Set true when the dashboard is served over HTTPS.
QF_COOKIE_SECURE=false
# Trust X-Forwarded-For for client IPs (only behind a proxy you control).
QF_TRUST_PROXY_HEADERS=false
QF_ALLOW_REGISTRATION=true
QF_SESSION_TTL_HOURS=72

# Limits
QF_MAX_REQUEST_BYTES=1048576
QF_MAX_PAYLOAD_BYTES=65536
QF_MAX_RESULT_BYTES=65536
QF_RATE_LIMIT_PER_MINUTE=600
QF_LOGIN_RATE_LIMIT_PER_MINUTE=10

# Accounts and email --------------------------------------------------------------------
# Public address of the dashboard; used to build links in emails.
QF_PUBLIC_URL=http://localhost:3000
# Make new accounts confirm their email before signing in (needs SMTP in production).
QF_REQUIRE_EMAIL_VERIFICATION=false
# SMTP for verification and password-reset emails. Leave QF_SMTP_HOST empty to only log them
# (development). Works with any provider: Brevo, Mailgun, SES, Postmark, Gmail and others.
QF_SMTP_HOST=
QF_SMTP_PORT=587
QF_SMTP_USERNAME=
QF_SMTP_PASSWORD=
QF_SMTP_FROM=QueueForge <no-reply@your-domain.example>
# starttls (port 587), ssl (port 465) or none
QF_SMTP_SECURITY=starttls

# Per-account limits ----------------------------------------------------------------------
# Defaults suit a private instance. For public sign-up, use the "Public instance" values.
# Public instance: 3
QF_MAX_PROJECTS_PER_USER=10
# Public instance: 5000
QF_MAX_JOBS_PER_DAY_PER_PROJECT=1000000
# Public instance: 20
QF_MAX_SCHEDULES_PER_PROJECT=100
# Public instance: 300
QF_MIN_SCHEDULE_INTERVAL_SECONDS=60
# Public instance: 120
QF_MAX_JOB_TIMEOUT_SECONDS=86400
# Public instance: 1000
QF_DEFAULT_MAX_QUEUED_JOBS=100000
# Public instance: 5000
QF_MAX_QUEUED_JOBS_LIMIT=10000000
# Caps every queue's concurrency so one account can't occupy every worker. Empty = no cap.
# Public instance: 2
QF_DEFAULT_QUEUE_CONCURRENCY=
# Comma-separated job types to turn off, e.g. the benchmark job on a public instance.
# Public instance: bench.synthetic
QF_DISABLED_JOB_TYPES=

# Outbound webhooks (http.request) ----------------------------------------------------------
# Keep false on any shared server: true lets jobs call localhost and private networks.
QF_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# Public instance: true
QF_WEBHOOK_REQUIRE_HTTPS=false
QF_WEBHOOK_MAX_TIMEOUT_SECONDS=30

# Workers
QF_WORKER_CONCURRENCY=8
# Comma-separated queue names a worker serves; empty = all queues.
QF_WORKER_QUEUES=
QF_LEASE_SECONDS=30
QF_HEARTBEAT_SECONDS=10
QF_SHUTDOWN_GRACE_SECONDS=20

# Scheduler / reconciler
QF_SCHEDULER_TICK_SECONDS=1
QF_RECONCILE_INTERVAL_SECONDS=15
QF_RECONCILE_GRACE_SECONDS=10

# Logging: json for production, console for local development.
QF_LOG_FORMAT=console
QF_LOG_LEVEL=INFO

# Demo seed (`queueforge seed`, refuses to run when QF_ENV=production).
QF_DEMO_EMAIL=demo@queueforge.dev
QF_DEMO_PASSWORD=queueforge-demo

# Frontend: where the Next.js server proxies /api/* (read at build and start time).
QF_API_URL=http://127.0.0.1:8000

# Docker Compose: host address the API (8000) and web (3000) ports are published on.
# Keep 127.0.0.1 behind a reverse proxy; 0.0.0.0 exposes them on every network interface.
QF_BIND_ADDRESS=127.0.0.1
